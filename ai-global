# 解析工具模式字串
parse_pattern() {
  IFS='|' read -r nodes key name agents_md rules commands skills subagents color <<< "$1"
  IFS=', ' read -ra node_array <<< "$nodes"
}

tool_node_exists() {
  local base_dir="$1"
  local tool_node="$2"
  shift 2

  if [[ "$tool_node" != "." ]]; then
    [[ -d "$base_dir/$tool_node" ]]
    return
  fi

  local type_node
  for type_node in "$@"; do
    if [[ "$type_node" != "." ]] && [[ -e "$base_dir/$type_node" ]]; then
      return 0
    fi
  done

  return 1
}

tool_type_path() {
  local base_dir="$1"
  local tool_node="$2"
  local type_node="$3"

  if [[ "$tool_node" == "." ]]; then
    echo "$base_dir/$type_node"
  else
    echo "$base_dir/$tool_node/$type_node"
  fi
}

relative_symlink_target() {
  local base_dir="$1"
  local link_path="$2"
  local target_path="$3"
  local link_parent
  link_parent=$(dirname "$link_path")

  if [[ "$link_parent" != "$base_dir" ]] && [[ "$link_parent" != "$base_dir/"* ]]; then
    echo "$target_path"
    return
  fi

  if [[ "$target_path" != "$base_dir/"* ]]; then
    echo "$target_path"
    return
  fi

  local parent_rel="${link_parent#$base_dir/}"
  local target_rel="${target_path#$base_dir/}"

  if [[ "$parent_rel" == "$link_parent" ]] || [[ -z "$parent_rel" ]]; then
    echo "$target_rel"
    return
  fi

  local prefix=""
  local parent_part
  IFS='/' read -ra parent_parts <<< "$parent_rel"
  for parent_part in "${parent_parts[@]}"; do
    [[ -n "$parent_part" ]] && prefix+="../"
  done

  echo "${prefix}${target_rel}"
}

symlink_target_for_mode() {
  local base_dir="$1"
  local link_path="$2"
  local target_path="$3"

  if [[ "$PROJECT_MODE" == true ]]; then
    relative_symlink_target "$base_dir" "$link_path" "$target_path"
  else
    echo "$target_path"
  fi
}

ensure_symlink() {
  local base_dir="$1"
  local link_path="$2"
  local target_path="$3"
  local link_target
  link_target=$(symlink_target_for_mode "$base_dir" "$link_path" "$target_path")

  if [[ -L "$link_path" ]]; then
    local current_target
    current_target=$(readlink "$link_path" 2> /dev/null || true)
    if [[ "$current_target" == "$link_target" ]]; then
      return 0
    fi
    rm -- "$link_path"
  fi

  mkdir -p "$(dirname "$link_path")" 2> /dev/null
  ln -s -- "$link_target" "$link_path"
}

global_tool_installed() {
  local project_key="$1"
  local project_tool_node="$2"
  local global_key="${project_key%-skills}"

  if [[ -d "$HOME/$project_tool_node" ]]; then
    return 0
  fi

  local pattern
  for pattern in "${KNOWN_PATTERNS[@]}"; do
    parse_pattern "$pattern"
    [[ "$key" != "$global_key" ]] && continue

    local global_tool_node
    for global_tool_node in "${node_array[@]}"; do
      if [[ -d "$HOME/$global_tool_node" ]]; then
        return 0
      fi
    done
  done

  return 1
}

add_unique_dir() {
  local dir="$1"
  shift
  local existing
  for existing in "$@"; do
    [[ "$existing" == "$dir" ]] && return 1
  done
  return 0
}

ensure_project_tool_dirs() {
  local base_dir="$1"
  local auto_dirs=()
  local confirm_dirs=()

  for pattern in "${PROJECT_KNOWN_PATTERNS[@]}"; do
    parse_pattern "$pattern"
    local project_key="$key"
    for tool_node in "${node_array[@]}"; do
      [[ "$tool_node" == "." ]] && continue
      if [[ ! -e "$base_dir/$tool_node" ]]; then
        if global_tool_installed "$project_key" "$tool_node"; then
          add_unique_dir "$tool_node" "${auto_dirs[@]}" && auto_dirs+=("$tool_node")
        else
          add_unique_dir "$tool_node" "${confirm_dirs[@]}" && confirm_dirs+=("$tool_node")
        fi
      elif [[ ! -d "$base_dir/$tool_node" ]]; then
        log_warn "不是目錄，略過建立: $(beautify_dir "$base_dir/$tool_node")"
      fi
    done
  done

  if [[ ${#auto_dirs[@]} -eq 0 ]] && [[ ${#confirm_dirs[@]} -eq 0 ]]; then
    return 0
  fi

  local missing_dir
  if [[ ${#auto_dirs[@]} -gt 0 ]]; then
    log_info "全域已安裝的工具缺少專案目錄，將直接建立:"
    for missing_dir in "${auto_dirs[@]}"; do
      echo "  - $(beautify_dir "$base_dir/$missing_dir")"
    done

    for missing_dir in "${auto_dirs[@]}"; do
      mkdir -p -- "$base_dir/$missing_dir"
      log_ok "已建立: $(beautify_dir "$base_dir/$missing_dir")"
    done
    echo ""
  fi

  if [[ ${#confirm_dirs[@]} -gt 0 ]]; then
    log_warn "全域未偵測到對應工具，專案模式缺少以下目錄:"
    for missing_dir in "${confirm_dirs[@]}"; do
      echo "  - $(beautify_dir "$base_dir/$missing_dir")"
    done

    read -r -p "是否仍要建立以上目錄?[y/N] " _reply
    _reply="${_reply:-N}"
    if [[ ! "$_reply" =~ ^[Yy]$ ]]; then
      log_info "已略過建立未安裝工具的專案目錄"
      echo ""
      return 0
    fi

    for missing_dir in "${confirm_dirs[@]}"; do
      mkdir -p -- "$base_dir/$missing_dir"
      log_ok "已建立: $(beautify_dir "$base_dir/$missing_dir")"
    done
    echo ""
  fi
}

copy_project_resource_dir() {
  local type_dir="$1"
  local target_dir="$2"
  local tool_name="$3"
  local type_node="$4"

  if [[ ! -d "$type_dir" ]]; then
    log_warn "不是目錄，略過複製與連結: $(beautify_dir "$type_dir")"
    return 1
  fi

  log_warn "專案模式偵測到既有目錄: $(beautify_dir "$type_dir")"
  log_warn "將備份原目錄，並可複製一份至 $(beautify_dir "$target_dir")"
  read -r -p "是否複製 $tool_name 的 $type_node?[y/N] " _reply
  _reply="${_reply:-N}"

  if [[ ! "$_reply" =~ ^[Yy]$ ]]; then
    log_info "已略過複製與連結: $(beautify_dir "$type_dir")"
    return 1
  fi

  while IFS= read -r -d '' -u 3 file_dir; do
    local target_file="$target_dir/${file_dir#$type_dir/}"
    if [[ -d "$target_file" ]]; then
      log_warn "目標是目錄，略過: $(beautify_dir "$target_file")"
      continue
    elif [[ -e "$target_file" ]]; then
      log_warn "目標已存在: $(beautify_dir "$target_file")"
      read -r -p "是否覆蓋?[y/N] " _overwrite
      _overwrite="${_overwrite:-N}"
      if [[ ! "$_overwrite" =~ ^[Yy]$ ]]; then
        log_info "已略過: $(beautify_dir "$target_file")"
        continue
      fi
    fi

    mkdir -p "$(dirname "$target_file")" 2> /dev/null
    cp -- "$file_dir" "$target_file" 2> /dev/null || true
  done 3< <(find "$type_dir" -type f -print0 2> /dev/null)

  return 0
}

project_managed_paths() {
  local managed_paths=(".ai-global")
  local pattern

  for pattern in "${PROJECT_KNOWN_PATTERNS[@]}"; do
    parse_pattern "$pattern"

    local type_node
    for tool_node in "${node_array[@]}"; do
      for type_node in "$agents_md" "$rules" "$commands" "$skills" "$subagents"; do
        [[ "$type_node" == "." ]] && continue
        local managed_path
        if [[ "$tool_node" == "." ]]; then
          managed_path="$type_node"
        else
          managed_path="$tool_node/$type_node"
        fi
        add_unique_dir "$managed_path" "${managed_paths[@]}" && managed_paths+=("$managed_path")
      done
    done
  done

  printf '%s\n' "${managed_paths[@]}"
}

show_project_git_tracking_hint() {
  local base_dir="$1"

  [[ "$PROJECT_MODE" != true ]] && return 0
  [[ ! -d "$base_dir/.git" ]] && return 0

  log_warn "偵測到專案目錄有 .git/，ai-global 建立的 symlink 或 .ai-global 可能被 Git 追蹤"
  read -r -p "$(printf '是否%b顯示%b「取消追蹤 / 添加至 .gitignore 」的建議指令？[y/N] ' "$RED" "$NC")" _reply
  _reply="${_reply:-N}"

  if [[ ! "$_reply" =~ ^[Yy]$ ]]; then
    return 0
  fi

  echo ""
  echo "  # 加入 .gitignore"
  echo "  cat >> .gitignore <<'EOF'"
  project_managed_paths
  echo "EOF"
  echo ""
  echo "  # 取消追蹤已被 Git 追蹤的 ai-global 專案模式檔案"
  echo "  git rm -r --cached --ignore-unmatch \\"

  local managed_path
  local paths
  local path_count
  local path_index=0
  paths=$(project_managed_paths)
  path_count=$(printf '%s\n' "$paths" | wc -l | tr -d ' ')
  while IFS= read -r managed_path; do
    [[ -z "$managed_path" ]] && continue
    path_index=$((path_index + 1))
    if [[ "$path_index" -lt "$path_count" ]]; then
      echo "    $managed_path \\"
    else
      echo "    $managed_path"
    fi
  done <<< "$paths"
  echo ""
}

# 確認特定資源類型是否已有任何工具的 symlink 指向 .ai-global
check_type_linked() {
  local base_dir="$1"
  local type_name="$2"

  for pattern in "${ACTIVE_PATTERNS[@]}"; do
    parse_pattern "$pattern"

    local type_node
    case "$type_name" in
      skills)   type_node="$skills" ;;
      rules)    type_node="$rules" ;;
      commands) type_node="$commands" ;;
      *) continue ;;
    esac
    [[ "$type_node" == "." ]] && continue

    for tool_node in "${node_array[@]}"; do
      local type_dir
      type_dir=$(tool_type_path "$base_dir" "$tool_node" "$type_node")
      if [[ -L "$type_dir" ]]; then
        local target
        target=$(readlink "$type_dir" 2>/dev/null || true)
        if [[ "$target" == *".ai-global"* ]]; then
          return 0
        fi
      fi
    done
  done

  return 1
}

supports_project_mode() {
  local cmd="$1"
  case "$cmd" in
    update | \
    list | -l | --list | \
    list-skills | -ls | --list-skills | \
    list-rules | -lr | --list-rules | \
    list-commands | -lc | --list-commands | \
    list-agents | -la | --list-agents | \
    relink | -r | --relink | \
    unlink | --unlink | \
    add-skill | add-rule | add-command | \
    update-skills | remove-skill | \
    render-skills | -rs | --render-skills | \
    disable | enable)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

prepare_run_base_dir() {
  local cmd="$1"

  local current_dir
  current_dir=$(pwd -P)
  local home_dir
  home_dir=$(cd "$HOME" && pwd -P)

  if [[ "$PROJECT_MODE" != true ]]; then
    if [[ "$current_dir" != "$home_dir" ]] && [[ -d "$current_dir/.git" ]] && supports_project_mode "$cmd"; then
      if [[ "$FORCE_GLOBAL_MODE" == true ]]; then
        RUN_BASE_DIR="$HOME"
        ACTIVE_PATTERNS=("${KNOWN_PATTERNS[@]}")
        ACTIVE_UNLINK_RELINK_PATTERNS=("${UNLINK_RELINK_PATTERNS[@]}")
        return 0
      else
        log_warn "偵測到 Git 專案目錄: $(beautify_dir "$current_dir")"
        read -r -p "是否切換為專案模式？[y/N] " _reply
        _reply="${_reply:-N}"

        if [[ "$_reply" =~ ^[Yy]$ ]]; then
          PROJECT_MODE=true
          PROJECT_MODE_AUTO=true
        else
          RUN_BASE_DIR="$HOME"
          ACTIVE_PATTERNS=("${KNOWN_PATTERNS[@]}")
          ACTIVE_UNLINK_RELINK_PATTERNS=("${UNLINK_RELINK_PATTERNS[@]}")
          return 0
        fi
      fi
    else
      RUN_BASE_DIR="$HOME"
      ACTIVE_PATTERNS=("${KNOWN_PATTERNS[@]}")
      ACTIVE_UNLINK_RELINK_PATTERNS=("${UNLINK_RELINK_PATTERNS[@]}")
      return 0
    fi
  fi

  if [[ "$current_dir" == "$home_dir" ]]; then
    log_error "專案模式不能在家目錄執行"
    echo ""
    return 1
  fi

  if ! supports_project_mode "$cmd"; then
    log_error "-p/--project 不支援此指令: $cmd"
    echo "支援指令: update, list, list-*, relink, unlink, add-*"
    echo ""
    return 1
  fi

  if [[ "$PROJECT_MODE" == true ]]; then
    log_warn "將目前目錄視為專案目錄: $(beautify_dir "$current_dir")"
    if [[ "$PROJECT_MODE_AUTO" != true ]]; then
      read -r -p "是否繼續?[Y/n] " _reply
      _reply="${_reply:-Y}"

      if [[ ! "$_reply" =~ ^[Yy]$ ]]; then
        log_info "已取消"
        echo ""
        return 1
      fi
    fi
  fi

  RUN_BASE_DIR="$current_dir"
  ACTIVE_PATTERNS=("${PROJECT_KNOWN_PATTERNS[@]}")
  ACTIVE_UNLINK_RELINK_PATTERNS=("${PROJECT_UNLINK_RELINK_PATTERNS[@]}")
  return 0
}

# 更新：掃描、合併、更新 symlink
update_links() {
  local base_dir="${1:-$HOME}"
  log_context_info "$base_dir" || return

  log_info "正在掃描 AI 工具..."

  local agents_md_dir="$base_dir/.ai-global/AGENTS.md"
  local rules_dir="$base_dir/.ai-global/rules"
  local commands_dir="$base_dir/.ai-global/commands"
  local skills_dir="$base_dir/.ai-global/skills"
  local subagents_dir="$base_dir/.ai-global/agents"
  local backups_dir="$base_dir/.ai-global/backups"

  local total_tools=0

  # 若 .ai-global 目錄不存在則建立
  if [[ ! -d "$base_dir/.ai-global" ]]; then
    mkdir -p "$base_dir/.ai-global"
  fi

  # 處理 AGENTS.md
  local is_new_agents_md=false
  if [[ ! -L "$agents_md_dir" ]] && [[ ! -f "$agents_md_dir" ]]; then
    touch "$agents_md_dir"
    is_new_agents_md=true
  fi

  # 建立目錄
  mkdir -p "$rules_dir" "$commands_dir" "$skills_dir" "$subagents_dir" "$backups_dir"

  for pattern in "${ACTIVE_PATTERNS[@]}"; do
    parse_pattern "$pattern"

    for tool_node in "${node_array[@]}"; do
      local tool_dir="$base_dir/$tool_node"

      if tool_node_exists "$base_dir" "$tool_node" "$agents_md" "$rules" "$commands" "$skills" "$subagents"; then
        total_tools=$((total_tools + 1))

        echo ""
        echo -e "${GREEN}[OK]${NC} ${color}找到: $name${NC}"

        local _type_keys=("file" "dir" "dir" "dir" "dir")
        local _type_nodes=("$agents_md" "$rules" "$commands" "$skills" "$subagents")
        local _type_targets=("$agents_md_dir" "$rules_dir" "$commands_dir" "$skills_dir" "$subagents_dir")

        for _ti in "${!_type_keys[@]}"; do
          local type_key="${_type_keys[$_ti]}"
          local type_node="${_type_nodes[$_ti]}"
          local target_dir="${_type_targets[$_ti]}"

          if [[ "$type_node" != "." ]]; then
            local type_dir
            type_dir=$(tool_type_path "$base_dir" "$tool_node" "$type_node")

            # 若非 symlink，則建立 symlink
            if [[ ! -L "$type_dir" ]]; then
              local should_link=true

              # 若目錄已存在，備份、複製、移除
              if [[ -e "$type_dir" ]]; then
                # 備份
                local backup_file="$backups_dir/${tool_node//\//_}.${type_node//\//_}.backup"
                cp -r -- "$type_dir" "$backup_file" 2> /dev/null

                if [[ "$type_key" == "file" ]]; then
                  # 複製
                  if [[ "$is_new_agents_md" == true ]]; then
                    mkdir -p "$(dirname "$target_dir")" 2> /dev/null
                    echo "<!-- $name -->" >> "$target_dir"
                    cat -- "$type_dir" >> "$target_dir"
                    echo "" >> "$target_dir"
                    echo "" >> "$target_dir"
                  fi
                else
                  if [[ "$PROJECT_MODE" == true ]]; then
                    copy_project_resource_dir "$type_dir" "$target_dir" "$name" "$type_node" || should_link=false
                  else
                    # 若共用目錄已有其他工具的檔案，發出警告
                    local existing_count
                    existing_count=$(find "$target_dir" -type f 2>/dev/null | wc -l | tr -d ' ')
                    if [[ "$existing_count" -gt 0 ]]; then
                      log_warn "共用目錄 $(beautify_dir "$target_dir") 已有 $existing_count 個檔案"
                      log_warn "來自 ${color}$name${NC}${YELLOW} 的檔案將合併至共用目錄${NC}"
                    fi

                    # 複製所有檔案（若存在則覆蓋）
                    find "$type_dir" -type f -print0 2> /dev/null | while IFS= read -r -d '' file_dir; do
                      local target_file="$target_dir/${file_dir#$type_dir/}"
                      mkdir -p "$(dirname "$target_file")" 2> /dev/null
                      cp -- "$file_dir" "$target_file" 2> /dev/null || true
                    done
                  fi
                fi

                # 移除
                [[ "$should_link" == true ]] && rm -rf -- "$type_dir"
              fi

              # 建立 symlink
              if [[ "$should_link" == true ]]; then
                ensure_symlink "$base_dir" "$type_dir" "$target_dir"
              fi
            elif [[ "$PROJECT_MODE" == true ]]; then
              ensure_symlink "$base_dir" "$type_dir" "$target_dir"
            fi

            [[ ! -L "$type_dir" ]] && continue

            # 顯示 symlink
            local src_dir=$(beautify_dir "$type_dir")
            local tgt_dir=$(beautify_dir "$target_dir")
            local src_spaces=$((40 - ${#src_dir}))
            src_spaces=$((src_spaces > 0 ? src_spaces : 1))
            local src_spacing="                                        "
            src_spacing="${src_spacing:0:$src_spaces}"
            echo -e "${color}${src_dir}${src_spacing} ${GRAY}→ ${tgt_dir}${NC}"
          fi
        done
      fi
    done
  done

  echo ""

  # 檢查是否找到任何工具
  if [[ $total_tools -eq 0 ]]; then
    log_info "未找到任何 AI 工具設定"
    log_info "未偵測到 AI 工具設定目錄 (如 ~/.claude/ 或 ~/.agents/)"
    # 移除空的 .ai-global 目錄
    rm -rf -- "$base_dir/.ai-global" 2> /dev/null
    echo ""
    return
  fi

  if [[ "$is_new_agents_md" == true ]]; then
    if [[ -f "$agents_md_dir" ]] && ! grep -q '[^[:space:]]' "$agents_md_dir" 2> /dev/null; then
      cat > "$agents_md_dir" << 'EOF'
# AI 工具指令

<!-- 在此加入您的提示詞，將同步至所有 AI 工具。 -->
EOF
    fi
    log_info "已合併 AGENTS.md: $(beautify_dir "$agents_md_dir")"
  else
    log_info "跳過合併: $(beautify_dir "$agents_md_dir") (已存在)"
  fi

  # v-skills 有內容時，順手把扁平投影層重建起來
  if [[ -d "$(vskills_dir "$base_dir")" ]]; then
    if render_skills "$base_dir"; then
      [[ "$_RENDER_COUNT" -gt 0 ]] && log_info "skills 投影層已重建（$_RENDER_COUNT 個）"
    fi
  fi

  log_ok "完成！"
  show_project_git_tracking_hint "$base_dir"
  echo ""
}

# 顯示 symlink 狀態
show_status() {
  local base_dir="$HOME"
  log_context_info "$base_dir" || return

  local total_links=0

  local _so_agents_md="" _so_rules="" _so_commands="" _so_skills="" _so_subagents=""

  for pattern in "${ACTIVE_PATTERNS[@]}"; do
    parse_pattern "$pattern"

    for tool_node in "${node_array[@]}"; do
      local tool_dir="$base_dir/$tool_node"

      if tool_node_exists "$base_dir" "$tool_node" "$agents_md" "$rules" "$commands" "$skills" "$subagents"; then
        local _stype_nodes=("$agents_md" "$rules" "$commands" "$skills" "$subagents")
        local _stype_keys=("agents_md" "rules" "commands" "skills" "subagents")

        for _si in "${!_stype_nodes[@]}"; do
          local type_node="${_stype_nodes[$_si]}"
          local output_key="${_stype_keys[$_si]}"

          if [[ "$type_node" != "." ]]; then
            local type_dir
            type_dir=$(tool_type_path "$base_dir" "$tool_node" "$type_node")
            if [[ -L "$type_dir" ]]; then
              local target_dir
              target_dir=$(readlink "$type_dir" 2> /dev/null || true)
              if [[ "$target_dir" == *".ai-global"* ]]; then
                local beautified
                beautified=$(beautify_dir "$type_dir")
                local _line="  ${color}${beautified}${NC}\n"
                case "$output_key" in
                  agents_md) _so_agents_md+="$_line" ;;
                  rules) _so_rules+="$_line" ;;
                  commands) _so_commands+="$_line" ;;
                  skills) _so_skills+="$_line" ;;
                  subagents) _so_subagents+="$_line" ;;
                esac
                total_links=$((total_links + 1))
              fi
            fi
          fi
        done
      fi
    done
  done

  if [[ $total_links -eq 0 ]]; then
    echo "  未找到任何 symlink"
    echo ""
    return
  fi

  local _titles=("AGENTS.md" "rules" "commands" "skills" "agents")
  local _contents=("$_so_agents_md" "$_so_rules" "$_so_commands" "$_so_skills" "$_so_subagents")

  for _si in "${!_titles[@]}"; do
    local content="${_contents[$_si]}"
    if [[ -n "$content" ]]; then
      echo -e "${BLUE}[${_titles[$_si]}]${NC}"
      echo -e -n "$content\n"
    fi
  done
}

