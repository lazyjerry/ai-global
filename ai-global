# 依 source.md 紀錄重新安裝所有來自 GitHub 的 skill
# 把 skills/ 底下尚未收攏的實體目錄搬進 v-skills
# 有安裝紀錄 → <作者>/<repo>/<名稱>；沒有紀錄 → manual/<名稱>
# 先列完整清單再確認，選 N 不動任何檔案
adopt_flat_skills() {
  local base_dir="$1"
  local skills_dir="$base_dir/.ai-global/skills"
  local vdir
  vdir=$(vskills_dir "$base_dir")
  local source_file
  source_file=$(source_file_path "$base_dir")

  [[ ! -d "$skills_dir" ]] && return 0

  local -a _pend_names=()
  local entry
  while IFS= read -r entry; do
    [[ -z "$entry" ]] && continue
    _pend_names+=("$(basename "$entry")")
  done < <(list_unadopted_skill_dirs "$skills_dir")

  [[ ${#_pend_names[@]} -eq 0 ]] && return 0

  # 先清 macOS 垃圾檔，免得跟著被搬進 v-skills
  local cruft
  cruft=$(prune_macos_cruft "$skills_dir" "$vdir")

  # 決定每個的目標路徑
  local -a _adopt_targets=()
  local name recorded url owner_repo target
  for name in "${_pend_names[@]}"; do
    recorded=$(beautify_dir "$skills_dir/$name")
    url=""
    [[ -f "$source_file" ]] && url=$(awk -F'|' -v p="$recorded" \
      '$2 == "skill" && $3 == p { print $1 }' "$source_file" | tail -1)

    if [[ -n "$url" ]]; then
      # https://github.com/<owner>/<repo> → owner/repo
      owner_repo="${url#https://github.com/}"
      owner_repo="${owner_repo%.git}"
      owner_repo="${owner_repo%/}"
    else
      owner_repo=""
    fi

    if [[ -n "$owner_repo" ]] && [[ "$owner_repo" == */* ]]; then
      target="$vdir/$owner_repo/$name"
    else
      target="$vdir/manual/$name"
    fi
    _adopt_targets+=("$target")
  done

  echo ""
  log_warn "偵測到 ${#_pend_names[@]} 個尚未收攏的 skill，將搬進 v-skills:"
  [[ "$cruft" -gt 0 ]] && log_info "（順帶清除了 $cruft 個 macOS 垃圾檔）"
  echo ""
  local i
  for ((i = 0; i < ${#_pend_names[@]}; i++)); do
    printf "  %-40s → %s\n" "${_pend_names[$i]}" "$(beautify_dir "${_adopt_targets[$i]}")"
  done
  echo ""
  read -r -p "是否收攏?[y/N] " _reply
  _reply="${_reply:-N}"

  if [[ ! "$_reply" =~ ^[Yy]$ ]]; then
    log_info "已跳過收攏"
    return 0
  fi

  local moved=0 old_rec new_rec origin
  for ((i = 0; i < ${#_pend_names[@]}; i++)); do
    name="${_pend_names[$i]}"
    target="${_adopt_targets[$i]}"

    if [[ -e "$target" ]]; then
      log_warn "目標已存在，跳過: $(beautify_dir "$target")"
      continue
    fi

    mkdir -p -- "$(dirname "$target")"
    if ! mv -- "$skills_dir/$name" "$target"; then
      log_error "搬移失敗: $name"
      continue
    fi

    # source.md 的 path 改指向新的實體位置
    old_rec=$(beautify_dir "$skills_dir/$name")
    new_rec=$(beautify_dir "$target")
    if [[ -f "$source_file" ]]; then
      origin=$(awk -F'|' -v p="$old_rec" '$2 == "skill" && $3 == p { print $1 }' "$source_file" | tail -1)
      drop_source_record "$source_file" "skill" "$old_rec"
      [[ -n "$origin" ]] && record_source "$source_file" "$origin" "skill" "$new_rec"
    fi
    moved=$((moved + 1))
  done

  log_ok "已收攏 $moved 個 skill 進 v-skills"
  echo ""
}

# 移除來源倉庫已不再提供的 skill（實體、投影、安裝紀錄、個別停用規則一起清）
# $1: base_dir  $2: 來源 URL（僅供顯示）  其餘: 實體路徑
# 預設 Y：update-skills 的目的是讓本地與來源一致
remove_gone_skills() {
  local base_dir="$1"
  local repo_url="$2"
  shift 2
  local -a gone_dirs=("$@")

  [[ ${#gone_dirs[@]} -eq 0 ]] && return 0

  local skills_dir="$base_dir/.ai-global/skills"
  local vdir
  vdir=$(vskills_dir "$base_dir")
  local source_file
  source_file=$(source_file_path "$base_dir")
  local list_file
  list_file=$(disable_list_path "$base_dir")

  echo ""
  log_warn "$repo_url 已不再提供以下 ${#gone_dirs[@]} 個 skill（被移除或改名）:"
  local dir
  for dir in "${gone_dirs[@]}"; do
    echo "  $(beautify_dir "$dir")"
  done
  echo ""
  # stdin 已關閉（非互動執行）時 read 會失敗，不能讓空答案落到預設 Y 而直接刪除
  read -r -p "是否移除本地的舊版?[Y/n] " _reply || _reply="N"
  _reply="${_reply:-Y}"

  if [[ ! "$_reply" =~ ^[Yy] ]]; then
    log_info "已保留（之後的 update-skills 仍會再問）"
    return 0
  fi

  local link parent rel removed=0
  for dir in "${gone_dirs[@]}"; do
    # 先清投影 symlink：render_skills 遇到同名衝突會中止，屆時斷鏈會留在 skills/
    link="$skills_dir/$(basename "$dir")"
    [[ -L "$link" ]] && [[ ! -e "$link" || "$link" -ef "$dir" ]] && rm -f -- "$link"

    rm -rf -- "$dir"
    drop_source_record "$source_file" "skill" "$(beautify_dir "$dir")"

    if [[ "$dir" == "$vdir"/* ]]; then
      rel="${dir#$vdir/}"
      disable_list_remove "$list_file" "$rel" > /dev/null

      # 分類層空了就往上收，避免分類樹留下空層
      parent=$(dirname "$dir")
      while [[ "$parent" != "$vdir" ]] && rmdir -- "$parent" 2> /dev/null; do
        parent=$(dirname "$parent")
      done
    fi
    removed=$((removed + 1))
  done

  log_ok "已移除 $removed 個來源已不再提供的 skill"
}

update_skills() {
  local base_dir="${1:-$HOME}"
  local skills_dir="$base_dir/.ai-global/skills"
  local vdir
  vdir=$(vskills_dir "$base_dir")
  local source_file
  source_file=$(source_file_path "$base_dir")

  log_context_info "$base_dir/.ai-global" || return

  # 先把 skills/ 底下的實體 skill 收攏進 v-skills（會先列清單並確認）
  adopt_flat_skills "$base_dir"

  if [[ ! -f "$source_file" ]]; then
    log_warn "找不到安裝紀錄: $(beautify_dir "$source_file")"
    log_info "只有透過 add-skill 安裝的 skill 才有紀錄可供更新"
    render_skills "$base_dir"
    return 1
  fi

  # scope 要同時涵蓋 skills/ 與 v-skills/，否則已分類的紀錄會被當孤兒清掉
  local orphans
  orphans=$(prune_source_records "$source_file" "$skills_dir" "$vdir")
  [[ "$orphans" -gt 0 ]] && log_info "已清除 $orphans 筆孤兒紀錄（目標已不存在），原紀錄備份於 source.md.bak"

  # 逐一取出 skill 類型的來源倉庫（保持首次出現順序）
  local -a _repos=()
  local url path abs
  while IFS='|' read -r url label path; do
    [[ "$label" != "skill" ]] && continue
    abs=$(expand_source_path "$path")
    [[ "$abs" != "$skills_dir"/* ]] && [[ "$abs" != "$vdir"/* ]] && continue
    local seen=false
    for _r in "${_repos[@]}"; do
      [[ "$_r" == "$url" ]] && seen=true && break
    done
    [[ "$seen" == false ]] && _repos+=("$url")
  done < "$source_file"

  if [[ ${#_repos[@]} -eq 0 ]]; then
    log_warn "紀錄中沒有可更新的 skill"
    render_skills "$base_dir"
    return 0
  fi

  log_info "將從 ${#_repos[@]} 個來源重新安裝已紀錄的 skill:"
  for _r in "${_repos[@]}"; do
    echo "  - $_r"
  done
  echo ""
  log_warn "既有的 skill 資料夾會被覆蓋，本地修改將遺失"
  read -r -p "是否更新?[y/N] " _reply
  _reply="${_reply:-N}"

  if [[ ! "$_reply" =~ ^[Yy]$ ]]; then
    log_info "已取消更新"
    return 0
  fi

  for _r in "${_repos[@]}"; do
    # 取出此倉庫先前安裝的 skill 名稱與其實體路徑，更新時原地覆寫。
    # 兩個平行陣列同索引配對；同名 skill 在不同分類各佔一筆，各自更新。
    UPDATE_ONLY_NAMES=()
    UPDATE_TARGET_DIRS=()
    while IFS='|' read -r url label path; do
      [[ "$label" != "skill" ]] && continue
      [[ "$url" != "$_r" ]] && continue
      abs=$(expand_source_path "$path")
      [[ "$abs" != "$skills_dir"/* ]] && [[ "$abs" != "$vdir"/* ]] && continue
      UPDATE_ONLY_NAMES+=("$(basename "$path")")
      UPDATE_TARGET_DIRS+=("$abs")
    done < "$source_file"

    echo ""
    UPDATE_GONE_DIRS=()
    UPDATE_MODE=true
    download_from_github "$_r" "$skills_dir" "SKILL.md" "skill" "skills skill"
    UPDATE_MODE=false
    UPDATE_ONLY_NAMES=()
    UPDATE_TARGET_DIRS=()

    remove_gone_skills "$base_dir" "$_r" "${UPDATE_GONE_DIRS[@]}"
    UPDATE_GONE_DIRS=()
  done

  echo ""
  render_skills "$base_dir" && log_info "投影層已重建（$_RENDER_COUNT 個 skill）"
  log_ok "更新完成"
}

# 依 skill 名或 v-skills 相對路徑找出對應項目，逐行輸出相對路徑
# 查詢字串含 / 視為完整相對路徑，否則比對 skill 名（同名可能多筆）
vskills_resolve() {
  local query="$1"
  local base_dir="${2:-$HOME}"
  local vdir
  vdir=$(vskills_dir "$base_dir")

  local rel name
  while IFS='|' read -r rel name; do
    [[ -z "$rel" ]] && continue
    if [[ "$query" == */* ]]; then
      [[ "$rel" == "$query" ]] && echo "$rel"
    else
      [[ "$name" == "$query" ]] && echo "$rel"
    fi
  done < <(vskills_enumerate "$vdir")
}

# 解析查詢並處理 0 筆 / 多筆的錯誤訊息；成功時把相對路徑放進 _RESOLVED_REL
_RESOLVED_REL=""
resolve_one_skill() {
  local query="$1"
  local base_dir="$2"
  local action="$3"

  _RESOLVED_REL=""
  local -a matches=()
  local line
  while IFS= read -r line; do
    [[ -n "$line" ]] && matches+=("$line")
  done < <(vskills_resolve "$query" "$base_dir")

  if [[ ${#matches[@]} -eq 0 ]]; then
    if [[ -d "$base_dir/.ai-global/skills/$query" ]] && [[ ! -L "$base_dir/.ai-global/skills/$query" ]]; then
      log_error "$query 尚未收攏進 v-skills，無法$action"
      log_info "skills/ 那層是各工具直接讀的，請先執行 update-skills 收攏"
    else
      log_error "在 v-skills 中找不到: $query"
      log_info "可用 list-skills 查看已安裝的 skill"
    fi
    return 1
  fi

  if [[ ${#matches[@]} -gt 1 ]]; then
    log_error "有多個同名 skill，請改用完整路徑指定:"
    for line in "${matches[@]}"; do
      echo "  $line"
    done
    return 1
  fi

  _RESOLVED_REL="${matches[0]}"
  return 0
}

# 解析為 v-skills 底下的分類目錄（repo 層或 bucket 層皆可），成功時放進 _RESOLVED_CATEGORY
# 不印訊息，由呼叫端決定要不要退回單一 skill 的錯誤訊息
_RESOLVED_CATEGORY=""
resolve_category() {
  local query="${1%/}"
  local base_dir="${2:-$HOME}"

  _RESOLVED_CATEGORY=""
  [[ -z "$query" ]] && return 1

  case "$query" in
    . | .. | ./* | ../* | */./* | */../* | */. | */..) return 1 ;;
  esac

  local vdir
  vdir=$(vskills_dir "$base_dir")
  [[ ! -d "$vdir/$query" ]] && return 1
  # 含 SKILL.md 的是 skill 不是分類
  [[ -f "$vdir/$query/SKILL.md" ]] && return 1

  local rel name
  while IFS='|' read -r rel name; do
    [[ -z "$rel" ]] && continue
    if [[ "$rel" == "$query/"* ]]; then
      _RESOLVED_CATEGORY="$query"
      return 0
    fi
  done < <(vskills_enumerate "$vdir")

  return 1
}

# 列出某個分類底下的所有 skill 相對路徑
skills_under_category() {
  local prefix="$1"
  local vdir
  vdir=$(vskills_dir "${2:-$HOME}")
  local rel name
  while IFS='|' read -r rel name; do
    [[ -z "$rel" ]] && continue
    [[ "$rel" == "$prefix"* ]] && echo "$rel"
  done < <(vskills_enumerate "$vdir")
}

# 停用清單：加入一行（已存在回傳 1）
disable_list_add() {
  local list_file="$1"
  local rel="$2"
  [[ -f "$list_file" ]] && grep -qxF "$rel" "$list_file" && return 1
  echo "$rel" >> "$list_file"
  return 0
}

# 停用清單：移除完全相符的行（不存在回傳 1）
disable_list_remove() {
  local list_file="$1"
  local rel="$2"
  [[ ! -f "$list_file" ]] && return 1
  grep -qxF "$rel" "$list_file" || return 1
  local tmp="${list_file}.tmp.$$"
  # 不能用 grep ... && mv：移除最後一行時 grep -v 無輸出會回傳 1，mv 就不會執行
  grep -vxF "$rel" "$list_file" > "$tmp"
  mv -- "$tmp" "$list_file"
  return 0
}

# 停用清單：移除所有以 $2 為前綴的規則（含前綴本身），輸出移除條數
# 整組啟用與 remove-skill 都要一次清掉分類規則與其底下的個別規則
disable_list_remove_prefix() {
  local list_file="$1"
  local prefix="$2"

  [[ ! -f "$list_file" ]] && echo 0 && return 0

  local strip='{ line = $0; sub(/#.*/, "", line); gsub(/^[ \t]+|[ \t]+$/, "", line) }'
  local matched
  matched=$(awk -v p="$prefix" "$strip"' line != "" && index(line, p) == 1' "$list_file" | wc -l | tr -d ' ')
  if [[ "$matched" -gt 0 ]]; then
    local tmp="${list_file}.tmp.$$"
    awk -v p="$prefix" "$strip"' line != "" && index(line, p) == 1 { next } { print }' "$list_file" > "$tmp"
    mv -- "$tmp" "$list_file"
  fi
  echo "$matched"
}

# 找出命中某個 skill 的「整個分類」停用規則（/ 結尾），一行一條
matching_category_rules() {
  local rel="$1"
  local list_file
  list_file=$(disable_list_path "${2:-$HOME}")
  [[ ! -f "$list_file" ]] && return 0

  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line=$(trim_space "$line")
    [[ -z "$line" ]] && continue
    [[ "$line" != */ ]] && continue
    [[ "$rel" == "$line"* ]] && echo "$line"
  done < "$list_file"
}

# 停用 skill：只動 disable-skills.md 與投影層，不碰實體目錄與 source.md
disable_skill() {
  local query="$1"
  local base_dir="${2:-$HOME}"

  if [[ -z "$query" ]]; then
    log_error "用法: ai-global disable <skill-name|v-skills 相對路徑|分類路徑>"
    echo ""
    echo "範例:"
    echo "  ai-global disable pdf                              # 單一 skill"
    echo "  ai-global disable user/repo/in-progress/loop-me    # 同名時用完整路徑"
    echo "  ai-global disable user/repo/in-progress            # 整個 bucket"
    echo "  ai-global disable user/repo                        # 整個 repo"
    return 1
  fi

  log_context_info "$(vskills_dir "$base_dir")" || return

  local list_file
  list_file=$(disable_list_path "$base_dir")

  # 先試單一 skill，不是的話再試整個分類（repo 層或 bucket 層）
  # 用 vskills_resolve 探路而不是先呼叫 resolve_one_skill：log_* 印到 stdout，
  # 重導向吞不掉，探路失敗的「找不到」會漏給使用者
  if [[ -n "$(vskills_resolve "$query" "$base_dir")" ]]; then
    resolve_one_skill "$query" "$base_dir" "停用" || return 1
    local rel="$_RESOLVED_REL"
    if ! disable_list_add "$list_file" "$rel"; then
      log_info "已經在停用清單中: $rel"
      return 0
    fi
    if render_skills "$base_dir"; then
      log_ok "已停用: $rel"
      log_info "實體目錄與安裝紀錄未變動，用 enable 即可復原"
    else
      return 1
    fi
    return 0
  fi

  if ! resolve_category "$query" "$base_dir"; then
    # 既不是 skill 也不是分類，讓 resolve_one_skill 印出「找不到」
    resolve_one_skill "$query" "$base_dir" "停用" || return 1
  fi

  local prefix="$_RESOLVED_CATEGORY/"
  if grep -qxF "$prefix" "$list_file" 2> /dev/null; then
    log_info "整個分類已經在停用清單中: $prefix"
    return 0
  fi

  local -a subs=()
  local line
  while IFS= read -r line; do
    [[ -n "$line" ]] && subs+=("$line")
  done < <(skills_under_category "$prefix" "$base_dir")

  # 底下的個別規則會被分類規則涵蓋，先清掉避免清單長出重複語意
  disable_list_remove_prefix "$list_file" "$prefix" > /dev/null
  disable_list_add "$list_file" "$prefix" > /dev/null

  if render_skills "$base_dir"; then
    log_ok "已停用整個分類: ${prefix}（${#subs[@]} 個 skill）"
    log_info "實體目錄與安裝紀錄未變動，用 enable $_RESOLVED_CATEGORY 即可復原"
  else
    return 1
  fi
}

# 啟用 skill
enable_skill() {
  local query="$1"
  local base_dir="${2:-$HOME}"

  if [[ -z "$query" ]]; then
    log_error "用法: ai-global enable <skill-name|v-skills 相對路徑|分類路徑>"
    echo ""
    echo "範例:"
    echo "  ai-global enable pdf                               # 單一 skill"
    echo "  ai-global enable user/repo/in-progress/loop-me     # 同名時用完整路徑"
    echo "  ai-global enable user/repo/in-progress             # 整個 bucket"
    echo "  ai-global enable user/repo                         # 整個 repo"
    return 1
  fi

  log_context_info "$(vskills_dir "$base_dir")" || return

  local list_file
  list_file=$(disable_list_path "$base_dir")

  # 先試單一 skill，不是的話再試整個分類；探路同樣不能靠重導向（見 disable_skill）
  if [[ -n "$(vskills_resolve "$query" "$base_dir")" ]]; then
    resolve_one_skill "$query" "$base_dir" "啟用" || return 1
    local rel="$_RESOLVED_REL"
    if ! disable_list_remove "$list_file" "$rel"; then
      if is_skill_disabled "$rel" "$base_dir"; then
        log_error "$rel 是被「整個分類停用」的規則命中，不能單獨啟用"
        local rule
        while IFS= read -r rule; do
          [[ -n "$rule" ]] && log_info "請改用: ai-global enable ${rule%/}"
        done < <(matching_category_rules "$rel" "$base_dir")
        return 1
      fi
      log_info "本來就是啟用狀態: $rel"
      return 0
    fi
    if render_skills "$base_dir"; then
      log_ok "已啟用: $rel"
    else
      log_warn "已從停用清單移除，但投影未更新（見上方衝突訊息）"
      log_info "請先停用另一個同名 skill，再執行 render-skills"
      return 1
    fi
    return 0
  fi

  if ! resolve_category "$query" "$base_dir"; then
    # 既不是 skill 也不是分類，讓 resolve_one_skill 印出「找不到」
    resolve_one_skill "$query" "$base_dir" "啟用" || return 1
  fi

  # 整組啟用：分類規則與其底下的個別規則一起清掉
  local prefix="$_RESOLVED_CATEGORY/"
  local removed
  removed=$(disable_list_remove_prefix "$list_file" "$prefix")
  if [[ "$removed" -eq 0 ]]; then
    log_info "本來就是啟用狀態: $prefix"
    return 0
  fi

  if render_skills "$base_dir"; then
    log_ok "已啟用整個分類: ${prefix}（清掉 $removed 條停用規則）"
  else
    log_warn "已從停用清單移除 $removed 條規則，但投影未更新（見上方衝突訊息）"
    log_info "請先停用衝突的同名 skill，再執行 render-skills"
    return 1
  fi
}

# 移除某個 repo 裝的全部 skill（實體、投影、安裝紀錄、停用規則一起清）
# 以 repo 為單位與 add-skill 對稱；單一 skill 的開關是 disable / enable，不在這裡
remove_skill() {
  local input="$1"
  local base_dir="${2:-$HOME}"

  if [[ -z "$input" ]]; then
    log_error "用法: ai-global remove-skill <user/repo>"
    echo ""
    echo "範例:"
    echo "  ai-global remove-skill user/repo"
    echo "  ai-global remove-skill https://github.com/user/repo"
    echo ""
    log_info "移除以 repo 為單位（與 add-skill 對稱），會刪掉該 repo 裝的全部 skill"
    log_info "只想關掉其中一個請用 disable，實體與紀錄都會保留"
    return 1
  fi

  # 與 add_skill 用同一組驗證與解析，兩邊接受的輸入形式必須一致
  if not_github_ref "$input"; then
    log_error "輸入無效，請提供 GitHub 倉庫。"
    echo ""
    echo "範例:"
    echo "  ai-global remove-skill user/repo"
    echo "  ai-global remove-skill https://github.com/user/repo"
    return 1
  fi

  local parsed owner repo path
  parsed=$(parse_github_ref "$input")
  owner=$(echo "$parsed" | cut -d'/' -f1)
  repo=$(echo "$parsed" | cut -d'/' -f2)
  path=$(echo "$parsed" | cut -d'/' -f3-)

  if [[ -z "$owner" ]] || [[ -z "$repo" ]]; then
    log_error "無效的 GitHub 參照: $input"
    return 1
  fi

  if [[ -n "$path" ]]; then
    log_error "不支援子路徑，僅接受 user/repo 格式: $input"
    return 1
  fi

  local skills_dir="$base_dir/.ai-global/skills"
  local vdir
  vdir=$(vskills_dir "$base_dir")
  local repo_dir="$vdir/$owner/$repo"
  local github_url="https://github.com/$owner/$repo"

  log_context_info "$base_dir/.ai-global" || return

  # v-skills/<owner>/<repo> 本身含 SKILL.md → 這是單一 skill，不是 repo 安裝目錄
  if [[ -f "$repo_dir/SKILL.md" ]]; then
    log_error "$owner/$repo 是單一 skill，不是 repo 安裝目錄"
    log_info "remove-skill 以 repo 為單位；要停止使用單一 skill 請用: ai-global disable $owner/$repo"
    return 1
  fi

  local -a rels=()
  local line
  while IFS= read -r line; do
    [[ -n "$line" ]] && rels+=("$line")
  done < <(skills_under_category "$owner/$repo/" "$base_dir")

  local source_file
  source_file=$(source_file_path "$base_dir")
  local record_count=0
  [[ -f "$source_file" ]] && record_count=$(awk -F'|' -v u="$github_url" \
    '$1 == u && $2 == "skill"' "$source_file" | wc -l | tr -d ' ')

  if [[ ${#rels[@]} -eq 0 ]] && [[ "$record_count" -eq 0 ]]; then
    log_error "找不到從 $github_url 安裝的 skill"
    log_info "可用 list-skills 查看已安裝的 skill"
    return 1
  fi

  log_warn "即將刪除 $owner/$repo 安裝的全部 skill（${#rels[@]} 個）:"
  for line in "${rels[@]}"; do
    echo "  $line"
  done
  echo ""
  log_info "安裝來源: $github_url (可日後用 add-skill 重新安裝)"
  local orphan=$((record_count - ${#rels[@]}))
  [[ "$orphan" -gt 0 ]] && log_info "另有 $orphan 筆紀錄的路徑已不存在，會一併清除"
  echo ""
  read -r -p "確定刪除?[y/N] " _reply
  _reply="${_reply:-N}"

  if [[ ! "$_reply" =~ ^[Yy]$ ]]; then
    log_info "已取消"
    return 0
  fi

  [[ -d "$repo_dir" ]] && rm -rf -- "$repo_dir"
  # owner 底下沒有別的 repo 了就一併收掉，避免分類樹留下空層
  rmdir -- "$vdir/$owner" 2> /dev/null || true

  # 先清投影 symlink：render_skills 遇到同名衝突會中止，屆時斷鏈會留在 skills/
  local link link_target
  for link in "$skills_dir"/*; do
    [[ -L "$link" ]] || continue
    link_target=$(readlink "$link" 2> /dev/null || true)
    [[ "$link_target" == "../v-skills/$owner/$repo/"* ]] && rm -f -- "$link"
  done

  local dropped
  dropped=$(drop_source_records_by_url "$source_file" "$github_url" "skill")

  local removed
  removed=$(disable_list_remove_prefix "$(disable_list_path "$base_dir")" "$owner/$repo/")
  [[ "$removed" -gt 0 ]] && log_info "已從停用清單移除 $removed 條規則"

  render_skills "$base_dir" > /dev/null 2>&1

  echo ""
  log_ok "已移除 $owner/$repo 的 ${#rels[@]} 個 skill（清除 $dropped 筆安裝紀錄）"
}

# 升級
upgrade() {
  log_info "正在檢查更新..."

  # 從 GitHub API 取得最新 release tag
  local latest_tag
  latest_tag=$(curl -fsSL "https://api.github.com/repos/$REPO_SLUG/releases/latest" 2> /dev/null | grep '"tag_name"' | sed 's/.*"tag_name": "\(.*\)".*/\1/')

  if [[ -z "$latest_tag" ]]; then
    log_warn "無法取得最新版本"
    return 1
  fi

  local remote_version="${latest_tag#v}"

  if [[ "$remote_version" == "$VERSION" ]]; then
    log_ok "已是最新版本 (v$VERSION)"
    return 0
  fi

  log_info "正在升級: v$VERSION -> v$remote_version"

  local current_script="$0"
  # 若透過 symlink 執行，更新目標檔案
  if [[ -L "$current_script" ]]; then
    current_script=$(readlink "$current_script")
  fi

  local remote_url="https://raw.githubusercontent.com/$REPO_SLUG/$latest_tag/ai-global"
  local exec_temp
  exec_temp=$(mktemp)
  if curl -fsSL "$remote_url" -o "$exec_temp" 2> /dev/null; then
    chmod +x "$exec_temp"

    # 驗證下載的檔案是否為有效腳本
    if ! head -1 "$exec_temp" | grep -q '^#!/bin/bash'; then
      rm -f -- "$exec_temp"
      log_error "下載的檔案不是有效的腳本"
      return 1
    fi

    mv -- "$exec_temp" "$current_script"

    log_ok "已升級至 v$remote_version"
  else
    rm -f -- "$exec_temp"
    log_error "下載更新失敗"
    return 1
  fi
}

# 將所有 ai-global 設定備份至 .agents 目錄
backup_to_agents_dir() {
  local base_dir="$1"
  local config_dir="$base_dir/.ai-global"

  if [[ ! -d "$config_dir" ]]; then
    return 0
  fi

  local config_backup_dir="$base_dir/.agents_ai-global"
  rm -rf -- "$config_backup_dir" 2> /dev/null
  mkdir -p -- "$config_backup_dir"

  # 備份全部
  local types=("AGENTS.md" "skills" "rules" "agents" "commands")

  for type_node in "${types[@]}"; do
    if [[ -e "$config_dir/$type_node" ]]; then
      cp -r -- "$config_dir/$type_node" "$config_backup_dir/" 2> /dev/null
    fi
  done

  # 僅在備份目錄建立成功時記錄結果
  if [[ -d "$config_backup_dir" ]]; then
    log_ok "已將 $(beautify_dir "$config_dir") 備份至 ${GREEN}$(beautify_dir "$config_backup_dir")${NC}"
  fi
}

# 解除安裝
uninstall() {
  log_warn "此操作將完全移除 ai-global 及所有設定"
  read -r -p "確定要解除安裝嗎? [y/N] " _reply
  _reply="${_reply:-N}"

  if [[ ! "$_reply" =~ ^[Yy] ]]; then
    log_info "已取消解除安裝"
    return 0
  fi

  # 將所有設定備份至 .agents 目錄
  echo ""
  backup_to_agents_dir "$HOME"
  unlink_all_tools "$HOME"
  echo ""

  [[ -L /usr/local/bin/ai-global ]] && rm -f -- /usr/local/bin/ai-global
  [[ -L "$HOME/.local/bin/ai-global" ]] && rm -f -- "$HOME/.local/bin/ai-global"

  log_info "已保留設定目錄: $(beautify_dir "$HOME/.ai-global")（如需移除請手動刪除）"

  log_ok "AI Global 已成功解除安裝"
  echo ""
}

# 顯示版本
show_version() {
  echo "歡迎使用 ai-global. LazyJerry 版本 $VERSION"
}

INTERACTIVE_CMD=""
INTERACTIVE_ARG1=""

set_interactive_command() {
  local mode="$1"
  local command="$2"
  local argument="$3"

  if [[ "$mode" == "project" ]]; then
    PROJECT_MODE=true
    PROJECT_MODE_AUTO=true
  else
    FORCE_GLOBAL_MODE=true
  fi

  INTERACTIVE_CMD="$command"
  INTERACTIVE_ARG1="$argument"
}

prompt_interactive_arg() {
  local prompt="$1"
  local value
  read -r -p "$prompt" value
  echo "$value"
}

show_interactive_menu() {
  echo -e "${BLUE}AI Global 互動式選單${NC}"
  echo ""
  echo -e "${BLUE}全域模式 (~/.ai-global):${NC}"
  print_menu_items_for_mode "global"
  echo ""
  echo -e "${BLUE}專案模式 (目前目錄 ./.ai-global):${NC}"
  print_menu_items_for_mode "project"
  echo ""
  echo "  0) 離開"
  echo ""

  local choice
  read -r -p "請選擇: " choice

  if [[ "$choice" == "0" ]]; then
    log_info "已取消"
    return 1
  fi

  local item item_choice mode cmd arg_type label argument
  for item in "${INTERACTIVE_MENU_ITEMS[@]}"; do
    IFS='|' read -r item_choice mode cmd arg_type label <<< "$item"
    [[ "$item_choice" != "$choice" ]] && continue

    case "$arg_type" in
      key)
        argument=$(prompt_interactive_arg "工具 key 或 all: ")
        [[ -z "$argument" ]] && { log_error "未輸入工具 key"; return 1; }
        ;;
      repo)
        argument=$(prompt_interactive_arg "GitHub repo (user/repo): ")
        [[ -z "$argument" ]] && { log_error "未輸入 GitHub repo"; return 1; }
        ;;
      name)
        argument=$(prompt_interactive_arg "skill 名稱（同名時用 v-skills 相對路徑）: ")
        [[ -z "$argument" ]] && { log_error "未輸入 skill 名稱"; return 1; }
        ;;
      target)
        argument=$(prompt_interactive_arg "skill 名稱或分類路徑（user/repo、user/repo/bucket）: ")
        [[ -z "$argument" ]] && { log_error "未輸入 skill 名稱或分類路徑"; return 1; }
        ;;
      *)
        argument=""
        ;;
    esac

    set_interactive_command "$mode" "$cmd" "$argument"
    return 0
  done

  log_error "無效選項: $choice"
  return 1
}

# 主程式
main() {
  local args=()
  local arg

  for arg in "$@"; do
    case "$arg" in
      -p | --project)
        PROJECT_MODE=true
        ;;
      *)
        args+=("$arg")
        ;;
    esac
  done

  if [[ $# -eq 0 ]]; then
    show_interactive_menu || exit 1
    args=("$INTERACTIVE_CMD")
    [[ -n "$INTERACTIVE_ARG1" ]] && args+=("$INTERACTIVE_ARG1")
  fi

  local cmd="${args[0]}"
  local arg1="${args[1]}"

  # 處理空指令
  if [[ -z "$cmd" ]]; then
    cmd="update"
  fi

  prepare_run_base_dir "$cmd" || exit 1

  case "$cmd" in
    update) update_links "$RUN_BASE_DIR" ;;
    status | -s | --status) show_status ;;
    list | -l | --list) list_tools "$RUN_BASE_DIR" ;;
    backups | -b | --backups) list_backups ;;
    list-skills | -ls | --list-skills) list_skills "$RUN_BASE_DIR" ;;
    list-rules | -lr | --list-rules) list_rules "$RUN_BASE_DIR" ;;
    list-commands | -lc | --list-commands) list_commands "$RUN_BASE_DIR" ;;
    list-agents | -la | --list-agents) list_agents "$RUN_BASE_DIR" ;;
    relink | -r | --relink) relink_all "$RUN_BASE_DIR" ;;
    unlink | --unlink) unlink_tool "$arg1" "$RUN_BASE_DIR" ;;
    clean | -c | --clean) clean_backups ;;
    add-skill) add_skill "$arg1" "$RUN_BASE_DIR" ;;
    update-skills) update_skills "$RUN_BASE_DIR" ;;
    remove-skill) remove_skill "$arg1" "$RUN_BASE_DIR" ;;
    render-skills | -rs | --render-skills)
      log_context_info "$RUN_BASE_DIR/.ai-global"
      if render_skills "$RUN_BASE_DIR"; then
        log_ok "投影層已重建（$_RENDER_COUNT 個 skill）"
        echo ""
      else
        exit 1
      fi
      ;;
    disable) disable_skill "$arg1" "$RUN_BASE_DIR" ;;
    enable) enable_skill "$arg1" "$RUN_BASE_DIR" ;;
    add-rule) add_rule "$arg1" "$RUN_BASE_DIR" ;;
    add-command) add_command "$arg1" "$RUN_BASE_DIR" ;;

    upgrade | -u | --upgrade) upgrade ;;
    uninstall | --uninstall) uninstall ;;
    version | -v | --version) show_version ;;
    help | --help | -h) show_help ;;
    *)
      log_error "未知的指令: $cmd"
      show_help
      exit 1
      ;;
  esac
}

main "$@"
