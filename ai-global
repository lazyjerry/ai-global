# 美化目錄路徑顯示
beautify_dir() {
  local path="$1"
  if [[ "$path" == "$HOME"* ]]; then
    echo "~${path#$HOME}"
  else
    echo "$path"
  fi
}

# 顯示執行環境資訊
log_context_info() {
  local base_dir="$1"
  log_info "目錄: $(beautify_dir "$base_dir")"
  echo ""
}

format_menu_command() {
  local mode="$1"
  local cmd="$2"
  local arg_type="$3"
  local prefix="ai-global"

  [[ "$mode" == "project" ]] && prefix="ai-global -p"

  case "$arg_type" in
    key) echo "$prefix $cmd <key|all>" ;;
    repo) echo "$prefix $cmd <user/repo>" ;;
    name) echo "$prefix $cmd <name>" ;;
    target) echo "$prefix $cmd <name|分類路徑>" ;;
    *) echo "$prefix $cmd" ;;
  esac
}

print_menu_items_for_mode() {
  local mode="$1"
  local item choice item_mode cmd arg_type label command_ref

  for item in "${INTERACTIVE_MENU_ITEMS[@]}"; do
    IFS='|' read -r choice item_mode cmd arg_type label <<< "$item"
    [[ "$item_mode" != "$mode" ]] && continue
    command_ref=$(format_menu_command "$item_mode" "$cmd" "$arg_type")
    printf " %2s) %-16s %b%s%b\n" "$choice" "$label" "${GRAY}" "$command_ref" "${NC}"
  done
}

print_interactive_reference() {
  echo -e "${BLUE}互動式選單參考:${NC}"
