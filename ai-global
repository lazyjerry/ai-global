# ===================== v-skills 分類層 =====================
# v-skills 是唯一真相來源（多層巢狀分類），skills/ 只是扁平的 symlink 投影層。
# 各 AI 工具都只掃 skills/ 的第一層，所以投影必須扁平、skill 名必須唯一。

vskills_dir() {
  echo "${1:-$HOME}/.ai-global/v-skills"
}

disable_list_path() {
  echo "${1:-$HOME}/.ai-global/disable-skills.md"
}

# 去除字串前後空白（bash 3.2 相容）
trim_space() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  echo "$s"
}

# 列出 v-skills 中所有 skill，輸出「相對路徑|skill 名」
# 找到含 SKILL.md 的目錄就 prune，避免把 skill 自帶 references/ 裡的範例 SKILL.md 當成 skill
vskills_enumerate() {
  local vdir="$1"
  [[ ! -d "$vdir" ]] && return 0

  local dir rel
  while IFS= read -r dir; do
    [[ -z "$dir" ]] && continue
    rel="${dir#$vdir/}"
    echo "${rel}|$(basename "$dir")"
  done < <(find "$vdir" -mindepth 1 \
    \( -name '.git' -prune \) -o \
    \( -type d -exec test -e '{}/SKILL.md' \; -print -prune \) 2> /dev/null | sort)
}

# 判斷 skill 是否列在停用清單
# $1: v-skills 相對路徑  $2: base_dir
is_skill_disabled() {
  local rel="$1"
  local list_file
  list_file=$(disable_list_path "${2:-$HOME}")
  [[ ! -f "$list_file" ]] && return 1

  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line=$(trim_space "$line")
    [[ -z "$line" ]] && continue

    if [[ "$line" == */ ]]; then
      # 分類項：前綴比對，整個分類停用
      [[ "$rel" == "$line"* ]] && return 0
    else
      [[ "$rel" == "$line" ]] && return 0
    fi
  done < "$list_file"

  return 1
}

# 清除 macOS 產生的垃圾檔，輸出刪除筆數
# 排除 skills/.system（Codex 自建，內有 .codex-system-skills.marker）
prune_macos_cruft() {
  local count=0
  local dir target
  for dir in "$@"; do
    [[ ! -d "$dir" ]] && continue
    while IFS= read -r target; do
      [[ -z "$target" ]] && continue
      rm -rf -- "$target" 2> /dev/null && count=$((count + 1))
    done < <(find "$dir" \
      \( -name '.system' -prune \) -o \
      \( \( -name '.DS_Store' -o -name '._*' -o -name '__MACOSX' \) -print \) 2> /dev/null)
  done
  echo "$count"
}

# 列出 skills/ 底下尚未收攏的實體目錄（symlink 不算，隱藏項如 .system 排除）
# 排除其他工具自管的同步目錄：Claude Code 會把 claude.ai 帳號的 skill 同步到
# ~/.claude/skills/synced/<bucket>/，並在 synced/ 放 .bucket-* 標記檔。
# 收攏它會被 Claude Code 立刻重建，而 v-skills 留下的舊快照會與同名 skill 衝突。
list_unadopted_skill_dirs() {
  local skills_dir="$1"
  local dir
  while IFS= read -r dir; do
    [[ -z "$dir" ]] && continue
    compgen -G "$dir/.bucket-*" > /dev/null && continue
    echo "$dir"
  done < <(find "$skills_dir" -mindepth 1 -maxdepth 1 -type d ! -name '.*' 2> /dev/null | sort)
}

# 重建投影層：只建 symlink，不搬任何實體檔案。必須冪等。
_RENDER_COUNT=0
render_skills() {
  local base_dir="${1:-$HOME}"
  local skills_dir="$base_dir/.ai-global/skills"
  local vdir
  vdir=$(vskills_dir "$base_dir")

  _RENDER_COUNT=0
  [[ ! -d "$skills_dir" ]] && return 0

  # 1. 收集啟用中的 skill（平行陣列，bash 3.2 沒有關聯陣列）
  local -a _rels=()
  local -a _names=()
  local rel name
  while IFS='|' read -r rel name; do
    [[ -z "$rel" ]] && continue
    is_skill_disabled "$rel" "$base_dir" && continue
    _rels+=("$rel")
    _names+=("$name")
  done < <(vskills_enumerate "$vdir")

  # 2. 同名且都啟用 → 中止，不動任何檔案
  local i j conflict=false
  for ((i = 0; i < ${#_names[@]}; i++)); do
    for ((j = i + 1; j < ${#_names[@]}; j++)); do
      if [[ "${_names[$i]}" == "${_names[$j]}" ]]; then
        if [[ "$conflict" == false ]]; then
          log_error "偵測到同名且都啟用的 skill，投影未更新:"
          conflict=true
        fi
        echo "  ${_names[$i]}"
        echo "    - ${_rels[$i]}"
        echo "    - ${_rels[$j]}"
      fi
    done
  done
  if [[ "$conflict" == true ]]; then
    echo ""
    log_info "請用 disable 停用其中一個後再試"
    return 1
  fi

  # 3. 投影名與 skills/ 底下尚未收攏的實體目錄撞名 → 中止
  local existing
  for ((i = 0; i < ${#_names[@]}; i++)); do
    existing="$skills_dir/${_names[$i]}"
    if [[ -e "$existing" ]] && [[ ! -L "$existing" ]]; then
      log_error "投影名與既有實體目錄衝突: $(beautify_dir "$existing")"
      log_info "該 skill 尚未收攏進 v-skills，請先執行 update-skills"
      return 1
    fi
  done

  # 4. 移除所有指向 v-skills 的舊 symlink（含 stale 的、指向已停用 skill 的）
  local link link_target
  while IFS= read -r link; do
    [[ -z "$link" ]] && continue
    link_target=$(readlink "$link" 2> /dev/null || true)
    if [[ "$link_target" == ../v-skills/* ]] || [[ "$link_target" == "$vdir"/* ]]; then
      rm -f -- "$link"
    fi
  done < <(find "$skills_dir" -mindepth 1 -maxdepth 1 -type l 2> /dev/null)

  # 5. 建立相對 symlink
  # 不用 ensure_symlink：它在全域模式回傳絕對路徑，而投影層的 link 與 target
  # 同在 .ai-global/ 內，用相對路徑才不怕整個目錄被搬動。
  local ai_global_dir="$base_dir/.ai-global"
  local link_path target_path rel_target
  for ((i = 0; i < ${#_names[@]}; i++)); do
    link_path="$skills_dir/${_names[$i]}"
    target_path="$vdir/${_rels[$i]}"
    rel_target=$(relative_symlink_target "$ai_global_dir" "$link_path" "$target_path")
    ln -sfn "$rel_target" "$link_path"
    _RENDER_COUNT=$((_RENDER_COUNT + 1))
  done

  return 0
}

# 列出全域資源目錄中的項目
list_global_resources() {
  local dir_name="$1"
  local label="$2"
  local base_dir="${3:-$HOME}"
  local target_dir="$base_dir/.ai-global/$dir_name"

  log_context_info "$target_dir" || return

  if [[ ! -d "$target_dir" ]]; then
    log_info "目錄不存在: $(beautify_dir "$target_dir")"
    echo ""
    return 0
  fi

  local entries
  entries=$(find "$target_dir" -mindepth 1 -maxdepth 1 ! -name '.*' | sort)

  if [[ -z "$entries" ]]; then
    log_info "未找到任何 $label"
    echo ""
    return 0
  fi

  echo -e "  ${BLUE}${label} 列表${NC}"
  echo "  ----------------------------------------------------------------------"

  while IFS= read -r entry; do
    [[ -z "$entry" ]] && continue
    local name
    name=$(basename "$entry")
    if [[ -d "$entry" ]]; then
      echo "  $name/"
    else
      echo "  $name"
    fi
  done <<< "$entries"

  echo ""
}

# 列出 skills：v-skills 分類樹 + 尚未收攏的實體目錄
list_skills() {
  local base_dir="${1:-$HOME}"
  local vdir
  vdir=$(vskills_dir "$base_dir")
  local skills_dir="$base_dir/.ai-global/skills"

  log_context_info "$base_dir/.ai-global" || return

  local -a _rels=() _names=() _states=()
  local rel name
  while IFS='|' read -r rel name; do
    [[ -z "$rel" ]] && continue
    _rels+=("$rel")
    _names+=("$name")
    if is_skill_disabled "$rel" "$base_dir"; then
      _states+=("disabled")
    else
      _states+=("enabled")
    fi
  done < <(vskills_enumerate "$vdir")

  # 標記同名且都啟用的（投影層是扁平的，這種情況 render 會中止）
  local i j
  for ((i = 0; i < ${#_names[@]}; i++)); do
    [[ "${_states[$i]}" != "enabled" ]] && continue
    for ((j = i + 1; j < ${#_names[@]}; j++)); do
      [[ "${_states[$j]}" != "enabled" ]] && continue
      if [[ "${_names[$i]}" == "${_names[$j]}" ]]; then
        _states[$i]="conflict"
        _states[$j]="conflict"
      fi
    done
  done

  if [[ ${#_rels[@]} -gt 0 ]]; then
    echo -e "  ${BLUE}v-skills 分類${NC}"
    echo "  ----------------------------------------------------------------------"
    local prev_cat="" cur_cat mark
    for ((i = 0; i < ${#_rels[@]}; i++)); do
      cur_cat=$(dirname "${_rels[$i]}")
      [[ "$cur_cat" == "." ]] && cur_cat="（根層）"
      if [[ "$cur_cat" != "$prev_cat" ]]; then
        echo "  ${cur_cat}/"
        prev_cat="$cur_cat"
      fi
      case "${_states[$i]}" in
        disabled) mark=" ${YELLOW}(停用)${NC}" ;;
        conflict) mark=" ${RED}(同名衝突)${NC}" ;;
        *) mark="" ;;
      esac
      echo -e "    ${_names[$i]}${mark}"
    done
    echo ""
  fi

  # 尚未收攏：skills/ 底下的實體目錄（symlink 不算，隱藏項如 .system 排除）
  local -a _pending=()
  local entry
  if [[ -d "$skills_dir" ]]; then
    while IFS= read -r entry; do
      [[ -z "$entry" ]] && continue
      _pending+=("$(basename "$entry")")
    done < <(list_unadopted_skill_dirs "$skills_dir")
  fi

  if [[ ${#_pending[@]} -gt 0 ]]; then
    echo -e "  ${YELLOW}尚未收攏${NC}（skills/ 底下的實體目錄，執行 update-skills 收攏進 v-skills）"
    echo "  ----------------------------------------------------------------------"
    for entry in "${_pending[@]}"; do
      echo "    $entry"
    done
    echo ""
  fi

  if [[ ${#_rels[@]} -eq 0 ]] && [[ ${#_pending[@]} -eq 0 ]]; then
    log_info "未找到任何 skill"
    echo ""
    return 0
  fi

  local en=0 dis=0 con=0
  for ((i = 0; i < ${#_states[@]}; i++)); do
    case "${_states[$i]}" in
      enabled) en=$((en + 1)) ;;
      disabled) dis=$((dis + 1)) ;;
      conflict) con=$((con + 1)) ;;
    esac
  done
  local summary="v-skills 啟用 ${en}、停用 ${dis}"
  [[ $con -gt 0 ]] && summary="${summary}、同名衝突 ${con}"
  [[ ${#_pending[@]} -gt 0 ]] && summary="${summary}；尚未收攏 ${#_pending[@]}"
  log_info "$summary"
  echo ""
}

