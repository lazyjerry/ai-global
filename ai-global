# 取消連結單一工具
unlink_one_tool() {
  local base_dir="$1"
  local tool_node="$2"
  local agents_md="$3"
  local rules="$4"
  local commands="$5"
  local skills="$6"
  local subagents="$7"
  local color="$8"

  local unlinked_count=0

  for type_node in "$agents_md" "$rules" "$commands" "$skills" "$subagents"; do
    if [[ "$type_node" != "." ]]; then
      local type_dir
      type_dir=$(tool_type_path "$base_dir" "$tool_node" "$type_node")
      if [[ -L "$type_dir" ]]; then
        rm -- "$type_dir"
        log_ok "已取消連結: ${color}$(beautify_dir "$type_dir")${NC}"
        ((unlinked_count++))

        # 從備份還原
        local backup_file="$base_dir/.ai-global/backups/${tool_node//\//_}.${type_node//\//_}.backup"
        if [[ -e "$backup_file" ]]; then
          cp -r -- "$backup_file" "$type_dir" 2> /dev/null
        fi
      fi
    fi
  done

  # 刪除工具備份
  local backups_dir="$base_dir/.ai-global/backups"
  [[ -d "$backups_dir" ]] && for backup_dir in "$backups_dir"/${tool_node//\//_}.*.backup; do
    [[ -e "$backup_dir" ]] && rm -rf -- "$backup_dir"
  done

  _UNLINK_COUNT=$unlinked_count
}

# 清理孤立備份
clean_backups() {
  local base_dir="$HOME"
  local backups_dir="$base_dir/.ai-global/backups"

  if [[ ! -d "$backups_dir" ]]; then
    log_info "備份目錄不存在"
    echo ""
    return
  fi

  local backups_list
  backups_list=$(find "$backups_dir" -maxdepth 1 -name "*.backup" 2> /dev/null | sort)

  if [[ -z "$backups_list" ]]; then
    log_info "未找到任何備份"
    echo ""
    return
  fi

  local orphaned_count=0
  local kept_count=0

  while IFS= read -r backup_path; do
    [[ -z "$backup_path" ]] && continue
    local backup_name
    backup_name=$(basename "$backup_path")

    # 從備份檔名反推工具是否仍存在
    local is_orphaned=true
    for pattern in "${ACTIVE_PATTERNS[@]}"; do
      parse_pattern "$pattern"
      for tool_node in "${node_array[@]}"; do
        local prefix="${tool_node//\//_}"
        if [[ "$backup_name" == "${prefix}."* ]]; then
          if tool_node_exists "$base_dir" "$tool_node" "$agents_md" "$rules" "$commands" "$skills" "$subagents"; then
            is_orphaned=false
          fi
        fi
      done
    done

    if [[ "$is_orphaned" == true ]]; then
      rm -rf -- "$backup_path"
      log_ok "已清理孤立備份: $(beautify_dir "$backup_path")"
      ((orphaned_count++))
    else
      ((kept_count++))
    fi
  done <<< "$backups_list"

  if [[ $orphaned_count -eq 0 ]]; then
    log_info "未找到孤立備份 ($kept_count 個備份仍有效)"
  else
    log_ok "已清理 $orphaned_count 個孤立備份"
  fi
  echo ""
}

# 重建所有 symlink
remove_symlinks_for_patterns() {
  local base_dir="$1"
  shift

  local pattern
  for pattern in "$@"; do
    parse_pattern "$pattern"
    for tool_node in "${node_array[@]}"; do
      if tool_node_exists "$base_dir" "$tool_node" "$agents_md" "$rules" "$commands" "$skills" "$subagents"; then
        local _type_nodes=("$agents_md" "$rules" "$commands" "$skills" "$subagents")
        for type_node in "${_type_nodes[@]}"; do
          if [[ "$type_node" != "." ]]; then
            local type_dir
            type_dir=$(tool_type_path "$base_dir" "$tool_node" "$type_node")
            if [[ -L "$type_dir" ]]; then
              rm -- "$type_dir"
            fi
          fi
        done
      fi
    done
  done
}

relink_all() {
  local base_dir="${1:-$HOME}"
  log_info "正在重建所有 symlink..."
  echo ""

  if [[ "$PROJECT_MODE" == true ]]; then
    ensure_project_tool_dirs "$base_dir"
  fi

  # 僅移除 symlink，不還原備份、不刪除備份
  remove_symlinks_for_patterns "$base_dir" "${ACTIVE_PATTERNS[@]}" "${ACTIVE_UNLINK_RELINK_PATTERNS[@]}"

  update_links "$base_dir"
}

# 取消連結所有工具
unlink_all_tools() {
  local base_dir="$1"
  log_context_info "$base_dir" || return

  local total_unlinked=0

  for pattern in "${ACTIVE_PATTERNS[@]}" "${ACTIVE_UNLINK_RELINK_PATTERNS[@]}"; do
    parse_pattern "$pattern"

    for tool_node in "${node_array[@]}"; do
      if tool_node_exists "$base_dir" "$tool_node" "$agents_md" "$rules" "$commands" "$skills" "$subagents"; then
        unlink_one_tool "$base_dir" "$tool_node" "$agents_md" "$rules" "$commands" "$skills" "$subagents" "$color"
        total_unlinked=$((total_unlinked + _UNLINK_COUNT))
      fi
    done
  done

  if [[ $total_unlinked -gt 0 ]]; then
    log_ok "已取消連結全部 $total_unlinked 個 symlink"
  else
    echo "  未找到任何 symlink"
  fi
}

# 取消連結指令
unlink_tool() {
  local query_key="$1"
  local base_dir="${2:-$HOME}"

  if [[ -z "$query_key" ]]; then
    log_error "用法: ai-global unlink <key> 或 ai-global unlink all"
    echo ""
    return 1
  fi

  if [[ "$query_key" == "all" ]]; then
    unlink_all_tools "$base_dir"
    echo ""
    return 0
  fi

  # 從目前模式的 patterns 中搜尋匹配的模式
  local match=""
  local is_legacy_match=false
  for pattern in "${ACTIVE_PATTERNS[@]}"; do
    parse_pattern "$pattern"
    if [[ "$key" == "$query_key" ]]; then
      match="$pattern"
      break
    fi
  done

  if [[ -z "$match" ]]; then
    for pattern in "${ACTIVE_UNLINK_RELINK_PATTERNS[@]}"; do
      parse_pattern "$pattern"
      if [[ "$key" == "$query_key" ]]; then
        match="$pattern"
        is_legacy_match=true
        break
      fi
    done
  fi

  if [[ -z "$match" ]]; then
    log_error "未知的工具: $query_key"
    echo "請使用正確的 <key>"
    echo ""
    list_tools
    return 1
  fi

  log_context_info "$base_dir" || return
  [[ "$is_legacy_match" == true ]] && log_warn "使用 unlink/relink legacy 設定清理已停用工具: $query_key"

  local has_found=false

  # 解析模式並取消連結工具
  parse_pattern "$match"

  for tool_node in "${node_array[@]}"; do
    if tool_node_exists "$base_dir" "$tool_node" "$agents_md" "$rules" "$commands" "$skills" "$subagents"; then
      has_found=true
      unlink_one_tool "$base_dir" "$tool_node" "$agents_md" "$rules" "$commands" "$skills" "$subagents" "$color"
      local unlinked_count=$_UNLINK_COUNT
      if [[ $unlinked_count -gt 0 ]]; then
        local display_dir="$base_dir/$tool_node"
        [[ "$tool_node" == "." ]] && display_dir="$base_dir"
        log_ok "已從 ${color}$(beautify_dir "$display_dir")${NC} 取消連結 $unlinked_count 個 symlink"
      else
        local display_dir="$base_dir/$tool_node"
        [[ "$tool_node" == "." ]] && display_dir="$base_dir"
        log_info "${color}$(beautify_dir "$display_dir")${NC} 未找到 symlink"
      fi
      echo ""
    fi
  done

  if [[ "$has_found" != true ]]; then
    log_warn "未找到工具 '$query_key'"
    echo ""
  fi
}

# 解析 GitHub 參照，取得 owner、repo 及可選路徑
parse_github_ref() {
  local input="$1"

  # 移除 https://github.com/ 或 github.com/ 前綴
  input="${input#https://github.com/}"
  input="${input#http://github.com/}"
  input="${input#github.com/}"

  # 移除 /blob/main/ 或 /blob/master/ 或 /tree/main/ 等路徑
  input=$(echo "$input" | sed -E 's|/blob/[^/]+/|/|; s|/tree/[^/]+/|/|')

  echo "$input"
}

# 從 frontmatter 中擷取名稱（name: "..."）
extract_meta_name() {
  local file="$1"
  local default_name="$2"
  if [[ ! -f "$file" ]]; then
    echo "$default_name"
    return
  fi
  # 匹配 name: "value" 或 name: value
  local extracted=$(grep -m 1 "^name:" "$file" | sed -E 's/^name:[[:space:]]*["'\'']?([^"'\'']+)["'\'']?/\1/' | xargs 2> /dev/null || true)
  if [[ -n "$extracted" ]]; then
    echo "$extracted"
  else
    echo "$default_name"
  fi
}

# 安裝來源紀錄檔路徑
source_file_path() {
  echo "${1:-$HOME}/.ai-global/source.md"
}

# 將紀錄中的 ~ 還原為絕對路徑
expand_source_path() {
  local path="$1"
  echo "${path/#\~/$HOME}"
}

# 移除指定 類型+路徑 的安裝紀錄
drop_source_record() {
  local source_file="$1"
  local label="$2"
  local path="$3"
  local suffix="|${label}|${path}"

  [[ ! -f "$source_file" ]] && return 0

  local tmp="${source_file}.tmp.$$"
  awk -v s="$suffix" 'substr($0, length($0) - length(s) + 1) != s' "$source_file" > "$tmp" \
    && mv -- "$tmp" "$source_file"
}

# 移除同一來源 URL 的所有紀錄，輸出移除筆數
# remove-skill 以 repo 為單位，逐筆呼叫 drop_source_record 會漏掉路徑已不存在的孤兒紀錄
drop_source_records_by_url() {
  local source_file="$1"
  local url="$2"
  local label="$3"

  [[ ! -f "$source_file" ]] && echo 0 && return 0

  local matched
  matched=$(awk -F'|' -v u="$url" -v l="$label" '$1 == u && $2 == l' "$source_file" | wc -l | tr -d ' ')
  if [[ "$matched" -gt 0 ]]; then
    local tmp="${source_file}.tmp.$$"
    awk -F'|' -v u="$url" -v l="$label" '!($1 == u && $2 == l)' "$source_file" > "$tmp"
    mv -- "$tmp" "$source_file"
  fi
  echo "$matched"
}

# 寫入安裝紀錄（upsert：同 類型+路徑 的舊行先移除再追加）
record_source() {
  local source_file="$1"
  local url="$2"
  local label="$3"
  local path="$4"

  drop_source_record "$source_file" "$label" "$path"
  echo "${url}|${label}|${path}" >> "$source_file"
}

# 整理安裝紀錄：去除重複行（保留最新來源），並移除 scope 目錄底下已不存在的孤兒紀錄
# scope 之外的紀錄一律原樣保留，避免誤刪其他資源類型的紀錄
# 可傳多個 scope（skills/ 與 v-skills/ 都要涵蓋，否則已分類的紀錄會被當孤兒清掉）
# 輸出被移除的孤兒紀錄筆數
prune_source_records() {
  local source_file="$1"
  shift
  local -a scope_dirs=("$@")
  [[ ! -f "$source_file" ]] && echo 0 && return 0

  cp -- "$source_file" "${source_file}.bak"

  local deduped="${source_file}.dedup.$$"
  awk -F'|' 'NF >= 3 {
    key = $2 "|" $3
    if (!(key in seen)) order[++n] = key
    seen[key] = $0
  }
  END { for (i = 1; i <= n; i++) print seen[order[i]] }' "$source_file" > "$deduped"

  local kept="${source_file}.kept.$$"
  : > "$kept"
  local orphans=0
  local line path abs_path scope in_scope
  while IFS= read -r line; do
    path=$(echo "$line" | cut -d'|' -f3-)
    abs_path=$(expand_source_path "$path")

    in_scope=false
    for scope in "${scope_dirs[@]}"; do
      [[ -n "$scope" ]] && [[ "$abs_path" == "$scope"/* ]] && in_scope=true && break
    done

    # 不屬於本次處理範圍的紀錄，不做存在性判斷
    if [[ "$in_scope" == false ]] || [[ -e "$abs_path" ]]; then
      echo "$line" >> "$kept"
    else
      orphans=$((orphans + 1))
    fi
  done < "$deduped"

  rm -f -- "$deduped"
  mv -- "$kept" "$source_file"
  echo "$orphans"
}

# 從 GitHub 下載資源（泛用）
# $1: GitHub 參照
# $2: 目標目錄
# $3: 中繼資料檔名（如 SKILL.md、RULE.md、COMMAND.md）
# $4: 資源標籤（如 skill、rule、command）
# $5: 搜尋子目錄（複數形 單數形，如 "skills skill"）
# 依預設分類機制決定實體安裝路徑
# skill → v-skills/<作者>/<repo>/<bucket…>/<名稱>；rule/command 維持原本的扁平目錄
install_target_path() {
  local resource_label="$1"
  local target_dir="$2"
  local owner="$3"
  local repo="$4"
  local bucket="$5"
  local name="$6"

  if [[ "$resource_label" != "skill" ]]; then
    echo "$target_dir/$name"
    return
  fi

  local vdir
  vdir="$(dirname "$target_dir")/v-skills"

  if [[ -n "$bucket" ]]; then
    echo "$vdir/$owner/$repo/$bucket/$name"
  else
    echo "$vdir/$owner/$repo/$name"
  fi
}

download_from_github() {
  local input="$1"
  local target_dir="$2"
  local meta_file="$3"
  local resource_label="$4"
  local search_dirs="$5"

  local parsed
  parsed=$(parse_github_ref "$input")
  local owner
  owner=$(echo "$parsed" | cut -d'/' -f1)
  local repo
  repo=$(echo "$parsed" | cut -d'/' -f2)
  local path
  path=$(echo "$parsed" | cut -d'/' -f3-)

  if [[ -z "$owner" ]] || [[ -z "$repo" ]]; then
    log_error "無效的 GitHub 參照: $input"
    return 1
  fi

  if [[ -n "$path" ]]; then
    log_error "不支援子路徑，僅接受 user/repo 格式: $input"
    return 1
  fi

  # 複製整個倉庫
  local tmp_dir
  tmp_dir=$(mktemp -d)
  local clone_url="https://github.com/$owner/$repo.git"

  log_info "正在複製: $clone_url"

  if git clone --depth 1 --single-branch "$clone_url" "$tmp_dir/$repo"; then
    echo ""
    local source_node="$tmp_dir/$repo"

    if [[ -d "$source_node" ]]; then

      # === 探索階段：找出可安裝的資源（不複製）===
      local -a _install_sources=()
      local -a _install_names=()
      local -a _install_categories=() # 來源 repo 內的 bucket，與 sources/names 同索引
      local _install_mode="" # meta_root | meta_sub | files

      # 1. 檢查根目錄是否包含中繼資料檔
      if [[ -f "$source_node/$meta_file" ]]; then
        _install_mode="meta_root"
        local name=$(extract_meta_name "$source_node/$meta_file" "$(basename "$source_node")")
        _install_sources+=("$source_node")
        _install_names+=("$name")
        _install_categories+=("")
      fi

      # 2. 檢查子目錄（含中繼資料的子目錄 → 直接檔案 fallback）
      if [[ ${#_install_sources[@]} -eq 0 ]]; then
        for dir in $search_dirs; do
          if [[ -d "$source_node/$dir" ]]; then
            # 2a. 搜尋包含中繼資料檔的子目錄
            for d in "$source_node/$dir"/*; do
              [[ ! -d "$d" ]] && continue
              if [[ -f "$d/$meta_file" ]]; then
                _install_mode="meta_sub"
                local name=$(extract_meta_name "$d/$meta_file" "$(basename "$d")")
                _install_sources+=("$d")
                _install_names+=("$name")
                _install_categories+=("")
              fi
            done

            # 2b. 若無中繼資料子目錄，直接複製目錄內的檔案
            if [[ ${#_install_sources[@]} -eq 0 ]]; then
              for f in "$source_node/$dir"/*; do
                [[ ! -f "$f" ]] && continue
                _install_mode="files"
                _install_sources+=("$f")
                _install_names+=("$(basename "$f")")
                _install_categories+=("")
              done
            fi
          fi

          if [[ ${#_install_sources[@]} -gt 0 ]]; then
            source_node="$source_node/$dir"
            break
          fi
        done
      fi

      # 3. 遞迴搜尋（fallback）
      # 先只掃 search_dirs 底下（bucket 結構的 repo 走這裡），都沒有才掃整個倉庫。
      # 不先限縮的話，像 orig-skills/ 這種「原始版本」目錄會一起被掃進來，
      # 與 skills/<bucket>/ 底下的同名 skill 對撞，導致投影完全建不起來。
      local _scan_root=""
      if [[ ${#_install_sources[@]} -eq 0 ]]; then
        for dir in $search_dirs; do
          if [[ -d "$source_node/$dir" ]] \
            && [[ -n "$(find "$source_node/$dir" -name "$meta_file" -not -path '*/.git/*' -print -quit 2> /dev/null)" ]]; then
            _scan_root="$source_node/$dir"
            break
          fi
        done
        [[ -z "$_scan_root" ]] && _scan_root="$source_node"
      fi

      if [[ ${#_install_sources[@]} -eq 0 ]]; then
        while IFS= read -r -d '' meta_path; do
          local meta_parent
          meta_parent=$(dirname "$meta_path")
          _install_mode="meta_sub"
          local name=$(extract_meta_name "$meta_path" "$(basename "$meta_parent")")
          _install_sources+=("$meta_parent")
          _install_names+=("$name")

          # bucket = 來源 repo 內的中間分類路徑（相對於掃描根）
          local _rel_parent="${meta_parent#$_scan_root/}"
          local _bucket
          _bucket=$(dirname "$_rel_parent")
          [[ "$_bucket" == "." ]] && _bucket=""
          local _sd
          for _sd in $search_dirs; do
            if [[ "$_bucket" == "$_sd" ]]; then
              _bucket=""
              break
            elif [[ "$_bucket" == "$_sd/"* ]]; then
              _bucket="${_bucket#$_sd/}"
              break
            fi
          done
          _install_categories+=("$_bucket")
        done < <(find "$_scan_root" -name "$meta_file" -not -path '*/.git/*' -print0)
      fi

      # === 決定每個資源的實體安裝路徑 ===
      # 更新模式沿用 source.md 記錄的原位置（才不會把分類與投影 symlink 弄丟）；
      # 一般安裝走預設分類機制。
      local -a _install_targets=()
      if [[ "$UPDATE_MODE" == true ]] && [[ ${#_install_sources[@]} -gt 0 ]]; then
        local -a _keep_sources=()
        local -a _keep_names=()
        local -a _keep_targets=()
        local -a _new_idx=()
        local -a _recorded_hit=() # 與 UPDATE_ONLY_NAMES 同索引，來源仍有的記 1
        local _k _hit
        for _i in "${!_install_sources[@]}"; do
          _hit=false
          for _k in "${!UPDATE_ONLY_NAMES[@]}"; do
            if [[ "${_install_names[$_i]}" == "${UPDATE_ONLY_NAMES[$_k]}" ]]; then
              # 同名可能對應多個實體位置（不同分類），每個都要各更新一份
              _keep_sources+=("${_install_sources[$_i]}")
              _keep_names+=("${_install_names[$_i]}")
              _keep_targets+=("${UPDATE_TARGET_DIRS[$_k]}")
              _recorded_hit[$_k]=1
              _hit=true
            fi
          done
          [[ "$_hit" == false ]] && _new_idx+=("$_i")
        done

        # 已記錄但來源已找不到的，交回 update_skills 確認後移除。
        # 走到這裡代表來源至少掃到一個 skill；一個都掃不到多半是倉庫改了結構，不當成「全部被移除」
        for _k in "${!UPDATE_ONLY_NAMES[@]}"; do
          [[ -z "${_recorded_hit[$_k]:-}" ]] && UPDATE_GONE_DIRS+=("${UPDATE_TARGET_DIRS[$_k]}")
        done

        # 來源新增、尚未安裝的 skill：沒有舊位置可沿用，走預設分類機制
        if [[ ${#_new_idx[@]} -gt 0 ]]; then
          local -a _new_targets=()
          log_info "$owner/$repo 有 ${#_new_idx[@]} 個尚未安裝的 $resource_label:"
          local _new_target
          for _i in "${_new_idx[@]}"; do
            _new_target=$(install_target_path "$resource_label" "$target_dir" \
              "$owner" "$repo" "${_install_categories[$_i]}" "${_install_names[$_i]}")
            _new_targets+=("$_new_target")
            printf "  %-40s → %s\n" "${_install_names[$_i]}" "$(beautify_dir "$_new_target")"
          done
          echo ""
          log_warn "請確認您已對此倉庫進行安全掃描"
          read -r -p "是否一併安裝?[Y/n] " _reply
          _reply="${_reply:-Y}"
          if [[ "$_reply" =~ ^[Yy] ]]; then
            for _k in "${!_new_idx[@]}"; do
              _i="${_new_idx[$_k]}"
              _keep_sources+=("${_install_sources[$_i]}")
              _keep_names+=("${_install_names[$_i]}")
              _keep_targets+=("${_new_targets[$_k]}")
            done
          else
            log_info "已跳過新增的 $resource_label"
          fi
          echo ""
        fi

        _install_sources=("${_keep_sources[@]}")
        _install_names=("${_keep_names[@]}")
        _install_targets=("${_keep_targets[@]}")
      else
        for _i in "${!_install_sources[@]}"; do
          _install_targets+=("$(install_target_path "$resource_label" "$target_dir" \
            "$owner" "$repo" "${_install_categories[$_i]}" "${_install_names[$_i]}")")
        done
      fi

      # === 確認階段 ===
      if [[ ${#_install_sources[@]} -gt 0 ]]; then
        log_info "找到以下 $resource_label:"
        for _name in "${_install_names[@]}"; do
          echo "  - $_name"
        done
        echo ""
        log_info "安裝目標: $(beautify_dir "$target_dir")"

        if [[ "$UPDATE_MODE" != true ]]; then
          log_warn "請確認您已對此倉庫進行安全掃描"
          read -r -p "是否安裝?[Y/n] " _reply
          _reply="${_reply:-Y}"

          if [[ ! "$_reply" =~ ^[Yy] ]]; then
            log_info "已取消安裝"
            rm -rf -- "$tmp_dir"
            return 0
          fi
        fi

        # === 安裝階段 ===
        local resource_count=0
        local -a _installed_names=()
        local -a _installed_paths=()

        case "$_install_mode" in
          meta_root | meta_sub)
            for _i in "${!_install_sources[@]}"; do
              local install_dir="${_install_targets[$_i]}"

              # 目標若是投影 symlink（更新既有 skill 時常見），先移除，
              # 否則 cp 會寫進 symlink 指向的實體、或把投影換成實體目錄
              [[ -L "$install_dir" ]] && rm -f -- "$install_dir"

              if [[ -d "$install_dir" ]]; then
                if [[ "$UPDATE_MODE" == true ]]; then
                  rm -rf -- "$install_dir"
                else
                  log_warn "目標資料夾已存在: $(beautify_dir "$install_dir")"
                  read -r -p "是否覆蓋 ${_install_names[$_i]}?[y/N] " _overwrite
                  _overwrite="${_overwrite:-N}"

                  if [[ "$_overwrite" =~ ^[Yy]$ ]]; then
                    rm -rf -- "$install_dir"
                  else
                    log_info "已跳過 ${_install_names[$_i]}"
                    continue
                  fi
                fi
              fi

              mkdir -p -- "$install_dir"
              cp -R -- "${_install_sources[$_i]}"/* "$install_dir/"
              echo "  - ${_install_names[$_i]}"
              resource_count=$((resource_count + 1))
              _installed_names+=("${_install_names[$_i]}")
              _installed_paths+=("$install_dir")
            done
            ;;
          files)
            for _i in "${!_install_sources[@]}"; do
              local target_file="${_install_targets[$_i]}"

              if [[ -f "$target_file" ]] && [[ "$UPDATE_MODE" != true ]]; then
                log_warn "目標檔案已存在: $(beautify_dir "$target_file")"
                read -r -p "是否覆蓋 ${_install_names[$_i]}?[y/N] " _overwrite
                _overwrite="${_overwrite:-N}"

                if [[ ! "$_overwrite" =~ ^[Yy]$ ]]; then
                  log_info "已跳過 ${_install_names[$_i]}"
                  continue
                fi
              fi

              cp -- "${_install_sources[$_i]}" "$target_file" 2> /dev/null || true
              echo "  - ${_install_names[$_i]}"
              resource_count=$((resource_count + 1))
              _installed_names+=("${_install_names[$_i]}")
              _installed_paths+=("$target_file")
            done
            ;;
        esac

        # === 紀錄安裝來源 ===
        # path 欄位一律記實際實體路徑，update-skills 靠它反推安裝目標
        local ai_global_dir
        ai_global_dir=$(dirname "$target_dir")
        local source_file="$ai_global_dir/source.md"
        local github_url="https://github.com/$owner/$repo"
        for _i in "${!_installed_paths[@]}"; do
          record_source "$source_file" "$github_url" "$resource_label" \
            "$(beautify_dir "${_installed_paths[$_i]}")"
        done

        # cp -R 會把 repo 裡第二層以下的 .DS_Store 一起帶進來
        if [[ "$resource_count" -gt 0 ]] && [[ "$resource_label" == "skill" ]]; then
          local _cruft
          _cruft=$(prune_macos_cruft "${_installed_paths[@]}")
          [[ "$_cruft" -gt 0 ]] && log_info "已清除 $_cruft 個 macOS 垃圾檔"
        fi

        echo ""
        if [[ "$resource_count" -gt 0 ]]; then
          log_ok "已從 $owner/$repo 新增 $resource_count 個 $resource_label"
          for _i in "${!_installed_paths[@]}"; do
            echo "    $(beautify_dir "${_installed_paths[$_i]}")"
          done
        else
          log_info "未新增任何 $resource_label"
        fi
      else
        local searched_dir="${source_node#$tmp_dir/$repo}"
        searched_dir="${searched_dir#/}"
        log_warn "在 $owner/$repo${searched_dir:+/$searched_dir} 中未找到 $resource_label"
      fi
    else
      log_error "找不到路徑: $path"
      rm -rf -- "$tmp_dir"
      return 1
    fi
    rm -rf -- "$tmp_dir"
  else
    rm -rf -- "$tmp_dir"
    log_error "複製失敗: $clone_url"
    return 1
  fi
}

# 檢查輸入是否為 GitHub 參照
not_github_ref() {
  local input="$1"
  # 匹配：user/repo、https://github.com/user/repo、github.com/user/repo
  if [[ "$input" =~ ^https?://github\.com/ ]] \
    || [[ "$input" =~ ^github\.com/ ]] \
    || [[ "$input" =~ ^[a-zA-Z0-9_-]+/[a-zA-Z0-9_.-]+(/.*)?$ ]]; then
    return 1
  fi
  return 0
}

# 新增 skill 至全域 skills 目錄
